[Unit]
Description=LiteCP local privileged management broker
Documentation=https://github.com/hostingtom/litecp
Wants=network-online.target
After=network-online.target
Requires=litecp-broker.socket
After=litecp-broker.socket
PartOf=litecp.service
RequiresMountsFor=/home/litecp

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/var/lib/litecp
EnvironmentFile=-/etc/litecp/litecp.env
Environment=GOGC=80
ExecStart=/usr/local/bin/litecp broker
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0027

# The panel must update Nginx, cron and website files, but it does not need
# general write access to the operating system.
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/litecp
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RuntimeDirectory=litecp
RuntimeDirectoryMode=0755
ReadWritePaths=/var/lib/litecp /var/backups/litecp /var/www/litecp /var/vmail /var/log/nginx /run/litecp /run/litecp-php73 /etc/nginx /etc/cron.d /etc/litecp/mail /etc/litecp/php73-pools /etc/litecp/php73-pools.conf
ReadWritePaths=-/etc/php -/etc/opt/remi -/etc/php-fpm.d
ReadWritePaths=-/etc/litecp/waf
ReadWritePaths=-/etc/litecp/dns
ReadWritePaths=/home/litecp
ReadWritePaths=-/etc/letsencrypt -/var/lib/letsencrypt -/var/log/letsencrypt

[Install]
WantedBy=multi-user.target
