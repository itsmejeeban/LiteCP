[Unit]
Description=LiteCP - By Hostingtom
Documentation=https://github.com/hostingtom/litecp
Wants=network-online.target
After=network-online.target
Requires=litecp-broker.service
After=litecp-broker.service

[Service]
Type=simple
User=litecp-web
Group=litecp-web
WorkingDirectory=/
EnvironmentFile=-/etc/litecp/frontend.env
Environment=GOGC=80
ExecStart=/usr/local/bin/litecp web
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0027

# The network-facing process has no host-management filesystem access. Only
# authenticated control operations are sent to the credential-checked broker.
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/var/lib/litecp -/var/backups/litecp -/var/vmail -/etc/shadow -/etc/letsencrypt -/run/podman -/run/docker.sock
TasksMax=256
MemoryMax=256M

[Install]
WantedBy=multi-user.target
